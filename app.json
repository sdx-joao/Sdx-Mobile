{
  "expo": {
    "name": "SDX Mobile",
    "slug": "sdx-mobile",
    "version": "1.0.0",
    "scheme": "sdxmobile",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sdxpro.mobile"
    },
    "android": {
      "package": "com.sdxpro.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O ScandexPRO usa a câmera para ler o QR Code das etiquetas de patrimônio."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "62ce89bc-bb9b-42f7-9770-8f44d79fae09"
      }
    },
    "owner": "sdx-joao",
    "updates": {
      "url": "https://u.expo.dev/62ce89bc-bb9b-42f7-9770-8f44d79fae09"
    }
  }
}
