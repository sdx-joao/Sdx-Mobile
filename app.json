{
  "expo": {
    "name": "Servus",
    "slug": "sdx-mobile",
    "version": "1.5.0",
    "scheme": "servus",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sdxpro.mobile"
    },
    "android": {
      "package": "com.sdxpro.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 25,
      "adaptiveIcon": {
        "backgroundColor": "#072AC8",
        "foregroundImage": "./assets/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "app.scandexplus.com.br", "pathPrefix": "/i" },
            { "scheme": "https", "host": "app.scandexplus.com.br", "pathPrefix": "/scan" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O Servus usa a câmera para ler o QR Code das etiquetas de patrimônio."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Servus usa o reconhecimento facial para desbloquear o app."
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "color": "#072AC8"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "O Servus usa a agenda para importar o telefone do solicitante ao cadastrá-lo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "62ce89bc-bb9b-42f7-9770-8f44d79fae09"
      }
    },
    "owner": "sdx-joao",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/62ce89bc-bb9b-42f7-9770-8f44d79fae09",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
