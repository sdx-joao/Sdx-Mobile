{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Avatar/**",
              "components/BlueHeader/**",
              "components/Icon/**",
              "components/MobileButton/**",
              "components/MobileCard/**",
              "components/SearchField/**",
              "components/SegmentedControl/**",
              "components/StatusBadge/**",
              "components/StatusDot/**",
              "components/TabBar/**",
              "export/scandex-mobile-concept/mobile/**",
              "mobile/**",
              "ui_kits/scandexpro/**",
              "uploads/Landing Page ScandexPlus/**",
              "uploads/Landing Page ScandexPlus/download/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|src|size|radius|color|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, initials, src, size, radius, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlueHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|eyebrow|onBack|action|brand|compact|children|style|key|ref|className|style|children)$/]",
        "message": "<BlueHeader> doesn't accept that prop. Declared props: title, subtitle, eyebrow, onBack, action, brand, compact, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|disabled|loading|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<MobileButton> doesn't accept that prop. Declared props: variant, size, fullWidth, disabled, loading, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|danger)$/]",
        "message": "<MobileButton> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<MobileButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|accent|padding|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<MobileCard> doesn't accept that prop. Declared props: variant, accent, padding, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:elevated|flat)$/]",
        "message": "<MobileCard> variant must be one of 'elevated' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|type|inputMode|leading|valid|clearable|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, type, inputMode, leading, valid, clearable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute[name.name='inputMode'] > Literal[value!=/^(?:text|numeric|tel|email|search|decimal)$/]",
        "message": "<SearchField> inputMode must be one of 'text' | 'numeric' | 'tel' | 'email' | 'search' | 'decimal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|count|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: key, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|variant|dot|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: label, color, variant, dot, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid)$/]",
        "message": "<StatusBadge> variant must be one of 'soft' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatusBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|reported|size|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, reported, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: key, label, icon."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
